#!/usr/bin/env python3
"""stt-helper: fallback STT when the resident stt-server is unavailable.

Usage: stt-helper <wav_file> [--model NAME] [--lang-prompt trad]
Takes the same model and script prompt as stt-server (PA passes them), and only
loads a model that is already cached: a fallback must not start a download.
Prints JSON {"text", "language"} on stdout.
"""
import argparse
import json
import os
import sys
import time

# Workaround for libiomp5 double-load on macOS (faster_whisper/ctranslate2 vs numpy/MKL).
# Must be set before importing faster_whisper.
os.environ.setdefault("KMP_DUPLICATE_LIB_OK", "TRUE")

parser = argparse.ArgumentParser()
parser.add_argument("wav")
parser.add_argument("--model", default="base")
parser.add_argument("--lang-prompt", default="")
args = parser.parse_args()

# Same initial_prompt as stt-server: controls simplified vs traditional output.
prompt = "以下是繁體中文的句子。" if args.lang_prompt.strip() in ("trad", "ja") else "以下是普通话的句子。"

from faster_whisper import WhisperModel

t0 = time.time()
try:
    print(f"[stt-helper] loading cached model '{args.model}'...", file=sys.stderr, flush=True)
    try:
        model = WhisperModel(args.model, device="cpu", compute_type="int8", local_files_only=True)
    except Exception as e:
        print(f"Whisper 模型 '{args.model}' 不在本机缓存中，备用转写不会下载模型({e})", file=sys.stderr, flush=True)
        sys.exit(2)
    print(f"[stt-helper] model loaded ({time.time()-t0:.1f}s), transcribing...", file=sys.stderr, flush=True)
    t1 = time.time()
    segments, info = model.transcribe(args.wav, beam_size=5, initial_prompt=prompt)
    text = " ".join(seg.text.strip() for seg in segments).strip()
    print(f"[stt-helper] done ({time.time()-t1:.1f}s) lang={info.language}", file=sys.stderr, flush=True)

    if text:
        print(json.dumps({"text": text, "language": info.language}, ensure_ascii=False))
    else:
        print("Empty result", file=sys.stderr)
        sys.exit(1)
except Exception as e:
    print(str(e), file=sys.stderr)
    sys.exit(1)
