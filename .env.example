# Pocket Agent Configuration
#
# Place this file at:
#   Development: project root (.env)
#   Packaged app: ~/.pocket-agent/.env
#
# Server connection settings are ONLY configured here (not in Settings UI).

# ── Server connection ──────────────────────────────────────
# Hermes gateway URL (required)
API_SERVER=http://localhost:8642

# API key for authentication (leave empty for no auth)
API_SERVER_KEY=

# Agent name — routes to openclaw/{agent} if set (e.g. "my-agent")
# API_AGENT=my-agent

# ── Optional features ──────────────────────────────────────
# Enable local command execution ([CMD:...] tags in LLM responses)
# ENABLE_LOCAL_COMMANDS=true

# ── Binary paths ───────────────────────────────────────────
# Edge TTS binary path (default: auto-resolved from PATH)
# EDGE_TTS_BIN=/path/to/edge-tts

# ── Voice / STT ────────────────────────────────────────────
# Python interpreter with faster_whisper installed (default: system python3)
# STT_PYTHON=/path/to/python3

# Whisper model for voice input (default: tiny)
#   tiny (39M)  — fastest, lower accuracy
#   base (74M)  — good balance
#   small (244M) — higher accuracy, slower
# STT_MODEL=tiny

# Whisper model for wake-word enrollment and detection (default: base)
#   Uses a separate model so wake detection can be more accurate than voice input.
# WAKE_STT_MODEL=base

# Force language for wake-word enrollment and detection (default: auto-detect)
#   Prevents Whisper from mis-detecting short audio as wrong languages.
#   Set to match your primary TTS voice language for best results.
#   Examples: zh (Chinese), en (English), ja (Japanese), ko (Korean)
# WAKE_LANGUAGE=zh

# Enable UI state debug logs in frontend (true/false)
VITE_PA_DEBUG_UI=false
