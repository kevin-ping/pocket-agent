# Pocket Agent Configuration
#
# Place this file at:
#   Development: project root (.env)
#   Packaged app: ~/.pocket-agent/.env
#
# Server connection settings are ONLY configured here (not in Settings UI).

# ── Server connection ──────────────────────────────────────
# Hermes gateway URL (required)
API_SERVER=http://localhost:8642

# API key for authentication (leave empty for no auth)
API_SERVER_KEY=

# Leave unset: when set, PA uses /v1/chat/completions, which has no stop
# command, so an interrupted turn keeps running in Hermes.
# API_AGENT=my-agent

# ── Binary paths ───────────────────────────────────────────
# Edge TTS binary path (default: ~/.pocket-agent/venv/bin/edge-tts, else PATH)
# EDGE_TTS_BIN=/path/to/edge-tts

# ── Voice / STT ────────────────────────────────────────────
# Advanced override — leave unset. PA builds its own venv at
# ~/.pocket-agent/venv (Python 3.9–3.12) and runs the voice service from it.
# STT_PYTHON only changes the interpreter that RUNS the voice service, not the
# one that builds the venv; it must already have requirements-stt.txt installed.
# STT_PYTHON=/path/to/python3

# Whisper model for voice input (default: base)
#   tiny (39M)  — fastest, lower accuracy
#   base (74M)  — good balance
#   small (244M) — higher accuracy, slower
# STT_MODEL=base

# Enable UI state debug logs in frontend (true/false)
VITE_PA_DEBUG_UI=false
